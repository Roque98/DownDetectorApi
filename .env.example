# SQL Server Configuration
# IMPORTANTE: Si SQL Server Browser no está corriendo, usa el servidor y puerto directo
# Ejemplo: DB_SERVER=DESKTOP-28V1QTH y DB_PORT=1533 (para SQLEXPRESS)
DB_SERVER=DESKTOP-28V1QTH
DB_DATABASE=DowndetectorDB

# SQL Server Authentication
DB_USER=usrmon
DB_PASSWORD=YourPassword123

# Puerto específico (1433 para instancia por defecto, 1533 común para SQLEXPRESS)
# Encuentra tu puerto con: Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Microsoft SQL Server\MSSQL*\MSSQLServer\SuperSocketNetLib\Tcp\IPAll'
DB_PORT=1533

# Encryption settings
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Application Configuration
NODE_ENV=development

# Execution Mode Configuration
# MODE: 'once' for single execution, 'loop' for continuous execution
EXECUTION_MODE=loop

# Interval in minutes for loop mode (ignored in 'once' mode)
INTERVAL_MINUTES=10

# Data Collection Settings
# Only collect data from the last N minutes (avoids inserting old data)
# Downdetector tiene delay, usa al menos 20 minutos
COLLECT_LAST_MINUTES=45

# Logging
LOG_LEVEL=info
